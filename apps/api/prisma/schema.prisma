generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SALES
  WAREHOUSE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum MovementType {
  RECEIPT // intrare marfă de la furnizor
  SALE // ieșire la confirmarea unei comenzi
  RETURN // retur în stoc la anularea unei comenzi confirmate
  ADJUSTMENT // corecție după inventar (poate fi + sau -)
}

model User {
  id           Int             @id @default(autoincrement())
  email        String          @unique
  name         String
  passwordHash String
  role         Role
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  orders       Order[]
  movements    StockMovement[]
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  taxId     String?  @unique // CUI
  email     String?
  phone     String?
  city      String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([name])
}

model Product {
  id         Int             @id @default(autoincrement())
  sku        String          @unique
  name       String
  unit       String          @default("buc")
  price      Decimal         @db.Decimal(12, 2)
  stock      Int             @default(0)
  minStock   Int             @default(0)
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  orderItems OrderItem[]
  movements  StockMovement[]
  alerts     StockAlert[]

  @@index([name])
}

model Order {
  id          Int             @id @default(autoincrement())
  customerId  Int
  customer    Customer        @relation(fields: [customerId], references: [id])
  status      OrderStatus     @default(PENDING)
  notes       String?
  total       Decimal         @db.Decimal(12, 2)
  createdById Int
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       OrderItem[]
  movements   StockMovement[]

  @@index([status, createdAt])
  @@index([customerId])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2) // prețul înghețat la momentul comenzii
  lineTotal Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
}

/// Jurnal imuabil: stocul curent din Product.stock trebuie să fie egal cu suma acestor mișcări.
model StockMovement {
  id        Int          @id @default(autoincrement())
  productId Int
  product   Product      @relation(fields: [productId], references: [id])
  type      MovementType
  quantity  Int // cu semn: + intrare, - ieșire
  reason    String?
  orderId   Int?
  order     Order?       @relation(fields: [orderId], references: [id])
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
}

/// Creată de jobul de fundal când stocul scade sub minim; rezolvată automat la reaprovizionare.
model StockAlert {
  id         Int       @id @default(autoincrement())
  productId  Int
  product    Product   @relation(fields: [productId], references: [id])
  stock      Int
  minStock   Int
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  /// = productId cât timp alerta e deschisă, NULL după rezolvare. Fiind unic (iar NULL-urile nu se
  /// ciocnesc), baza de date garantează cel mult o alertă deschisă per produs, chiar și cu joburi paralele.
  openFor    Int?      @unique

  @@index([resolvedAt])
  @@index([productId])
}
