DATABASE_URL="postgres://postgres:postgres@localhost:5432/mini_erp"
JWT_SECRET="dev-secret-change-me-at-least-32-characters"
PORT=4000
# Cu Redis pornit (docker compose up -d db redis), joburile merg în coadă și le procesează `npm run dev:worker`.
# Fără REDIS_URL, rulează direct în procesul API-ului.
REDIS_URL="redis://localhost:6379"
